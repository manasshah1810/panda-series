{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "next-app": {
      "root": "apps/next-app",
      "framework": "nextjs"
    },
    "vite-app": {
      "root": "apps/vite-app",
      "framework": "vite"
    },
    "panda-kit": {
      "root": "panda-kit",
      "framework": "vite",
      "buildCommand": "vite build demo --base /panda-kit/",
      "outputDirectory": "demo/dist"
    },
    "ep01-opening": {
      "root": "episodes/ep01-chef",
      "framework": "vite",
      "buildCommand": "vite build demo --base /ep01/",
      "outputDirectory": "demo/dist"
    }
  },
  "rewrites": [
    {
      "source": "/ep01/(.*)",
      "destination": {
        "service": "ep01-opening"
      }
    },
    {
      "source": "/panda-kit/(.*)",
      "destination": {
        "service": "panda-kit"
      }
    },
    {
      "source": "/vite/(.*)",
      "destination": {
        "service": "vite-app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "next-app"
      }
    }
  ]
}